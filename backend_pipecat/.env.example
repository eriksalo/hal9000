# HAL 9000 Pipecat Configuration

# Required: Anthropic API Key
ANTHROPIC_API_KEY=your_api_key_here

# Daily.co WebRTC Configuration (required for voice pipeline)
DAILY_ROOM_URL=https://your-domain.daily.co/room-name
DAILY_TOKEN=your_daily_token_here

# Person name (optional, defaults to "Dave")
PERSON_NAME=Dave

# Speech Recognition Configuration
# Use Vosk (1) or Whisper (0)
USE_VOSK=1

# Use Hailo-accelerated Whisper (only if USE_VOSK=0)
USE_HAILO=0

# TTS Configuration
# Use HTTP endpoint (1) or direct Piper (0)
USE_HTTP_TTS=1
FLASK_BASE_URL=http://localhost:5000

# Camera Configuration (inherited from original backend)
CAMERA_TYPE=picamera2
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15

# Audio Configuration (inherited from original backend)
AUDIO_INPUT_DEVICE=plughw:CARD=CMTECK,DEV=0
AUDIO_OUTPUT_DEVICE=default
MIC_GAIN=20
