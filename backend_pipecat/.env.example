# ---- HAL 9000 configuration (copy to .env) -----------------------------------

# Required
ANTHROPIC_API_KEY=sk-ant-...

# Conversation model (Opus 5.5 at low effort is the latency sweet spot; try claude-sonnet-5-5 if TTFT is too slow)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_SIDE_MODEL=claude-haiku-5-5          # reflection, web search, vision
LLM_MAX_TOKENS=1024
LLM_PROMPT_CACHING=true
LLM_CACHE_TTL=1h
LLM_WEB_SEARCH=true
LLM_VISION=true

# Speech-to-text: deepgram_flux (recommended) | deepgram | hailo | whisper | moonshine
STT_PROVIDER=deepgram_flux
STT_FALLBACK_PROVIDER=whisper            # used when offline and HAILO_ENABLED=false
DEEPGRAM_API_KEY=
STT_KEYTERMS=HAL,Dave,Discovery
WHISPER_MODEL=base.en
HAILO_WHISPER_VARIANT=small

# Text-to-speech: cartesia (recommended) | elevenlabs | piper
TTS_PROVIDER=cartesia
TTS_FALLBACK_PROVIDER=piper
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=                       # your cloned HAL voice id
CARTESIA_MODEL=sonic-3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
PIPER_URL=http://localhost:5002          # python -m piper.http_server --model hal_9000_model/hal.onnx --port 5002
PIPER_SAMPLE_RATE=22050

# Audio devices (PyAudio indices; list with: python -c "import pyaudio;p=pyaudio.PyAudio();[print(i,p.get_device_info_by_index(i)['name']) for i in range(p.get_device_count())]")
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_OUTPUT_DEVICE_INDEX=
AUDIO_IN_SAMPLE_RATE=16000
AUDIO_OUT_SAMPLE_RATE=24000

# Turn-taking (local Smart Turn is only used when STT does not do its own end-of-turn)
SMART_TURN_ENABLED=true
SMART_TURN_CPU_COUNT=2
SMART_TURN_STOP_SECS=2.0
VAD_STOP_SECS=0.2
IDLE_TIMEOUT_SECS=90                     # silence before HAL checks in; 2 check-ins then goodbye

# Memory
MEMORY_DIR=../memory
MEMORY_SEMANTIC_ENABLED=true
QDRANT_PATH=../memory/qdrant
MEMORY_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_RECALL_LIMIT=5

# Vision / presence
VISION_ENABLED=true
CAMERA_TYPE=picamera2                    # or opencv
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
FACE_DATABASE=../face_database.json
FACE_TOLERANCE=0.6
PRESENCE_THRESHOLD_SECS=3
DEPARTURE_THRESHOLD_SECS=5
GREETING_COOLDOWN_SECS=300
DETECTION_INTERVAL_SECS=0.2
NAME_HOLD_SECS=60                        # keep a recognised name on the eye display this long after they leave

# Wake word (openWakeWord on the echo-cancelled mic; ~5 ms/frame on the Pi 5)
# When enabled, conversations start on the wake phrase, not on a face appearing.
WAKE_ENABLED=true
WAKE_MODEL=hey_jarvis                    # stock: alexa | hey_mycroft | hey_jarvis | hey_rhasspy; or a path to a custom .onnx (e.g. models/hey_hal.onnx)
WAKE_THRESHOLD=0.5                       # 0..1; raise if it false-triggers, lower if it misses you
WAKE_TRIGGER_FRAMES=1                    # consecutive 80 ms frames over threshold before firing
WAKE_REFRACTORY_SECS=3                   # ignore repeat triggers this long after one fires
WAKE_FRAMEWORK=onnx                      # onnx (tflite has no wheel for Python 3.13 on arm64)
WAKE_VAD_THRESHOLD=0                     # >0 requires openWakeWord's own VAD to agree speech is present

# Hailo-10H (offline fallback brain + local Whisper)
HAILO_ENABLED=false
HAILO_APPS_PATH=/home/erik/hailo-apps
HAILO_OLLAMA_URL=http://localhost:8000   # hailo-ollama OpenAI-compatible endpoint
HAILO_OFFLINE_MODEL=qwen3:1.7b

# Servers
STATUS_PORT=5000                         # ESP32 polls /api/hal/display here
WEBRTC_PORT=7860
SERVER_HOST=0.0.0.0

# Misc
PERSON_NAME=Dave                         # default partner for hal_local.py / hal_webrtc.py
TIMEZONE=America/Denver
LOG_LEVEL=INFO

# --- Audio capture (CMTECK via PipeWire WebRTC echo-cancel) ---
# HAL captures from / plays to the PipeWire echo_cancel nodes (device index 2).
AUDIO_INPUT_DEVICE_INDEX=2
AUDIO_OUTPUT_DEVICE_INDEX=2
AUDIO_IN_SAMPLE_RATE=48000
AUDIO_OUT_SAMPLE_RATE=48000
# Optional software conditioning (normally off; WebRTC AGC handles levels):
AUDIO_INPUT_GAIN=1
AUDIO_INPUT_GATE_RMS=0
AUDIO_INPUT_TARGET_RMS=0
AUDIO_INPUT_MAX_GAIN=30
# Local VAD/turn tuning (only used when STT_PROVIDER is not deepgram_flux):
VAD_CONFIDENCE=0.3
VAD_MIN_VOLUME=0.0
SMART_TURN_ENABLED=false
# Camera mounted upside down -> rotate the feed 180 degrees:
CAMERA_ROTATE_180=true
